# Required in production: the single shared password.
ADMIN_PASSWORD=change-me
# Key for signing session cookies. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=
# Postgres connection string (Supabase transaction pooler, port 6543). Required in production.
# Leave unset locally: the app then uses an in-process database in data/pglite.
DATABASE_URL=
# Secret the Google Sheet script sends with each sync (at least 32 characters).
SYNC_KEY=
